# Required to publish through the configured X session
X_AUTH_TOKEN=
X_CT0=

# Required fallback for text generation
GEMINI_API_KEY=
# Optional second Gemini key used when the primary key is unavailable/rate-limited
GEMINI_API_KEY_BACKUP=

# Required for Cloudflare Workers AI text candidates and FLUX.1 [schnell] comparison images; Gemini handles builder prompts and text fallback
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
