# Required to publish through the configured X session
X_AUTH_TOKEN=
X_CT0=

# Required fallback for text generation
GEMINI_API_KEY=
# Optional second Gemini key used when the primary key is unavailable/rate-limited
GEMINI_API_KEY_BACKUP=

# Optional first-pass text candidate provider; Gemini fallback works without these
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
