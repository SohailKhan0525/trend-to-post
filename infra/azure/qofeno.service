[Unit]
Description=Qofeno continuous X publisher
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=qofeno
Group=qofeno
EnvironmentFile=/etc/qofeno-vault
Environment=HOME=/var/lib/qofeno
Environment=GIT_TERMINAL_PROMPT=0
Environment=PYTHONUNBUFFERED=1
StateDirectory=qofeno
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/qofeno-worker.py
Restart=always
RestartSec=60
KillMode=mixed
TimeoutStopSec=300
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
LimitCORE=0

[Install]
WantedBy=multi-user.target
